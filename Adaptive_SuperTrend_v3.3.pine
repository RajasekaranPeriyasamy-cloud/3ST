//@version=6
indicator("Adaptive SuperTrend - Multi-Method [v3.3]", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

// ==============================================================================
// INPUTS
// ==============================================================================
string G_MAIN    = "Basic Settings & Method"
string G_FILTERS = "Signal Filters"
string G_TSL     = "Trailing Stop Loss"
string G_TGTS    = "Three-Level Targets"
string G_VIS     = "Display & Stats Panel"

int    base_atr_len = input.int(10, "Base ATR Period", minval = 1, group = G_MAIN)
float  base_mult    = input.float(3.0, "Base Multiplier", minval = 0.1, step = 0.1, group = G_MAIN)
string method_type  = input.string("Hybrid", "Adaptation Method", options = ["Percentile", "Volatility Regime", "Z-Score", "Dynamic Period", "Rate of Change", "Multi-Timeframe", "Hybrid", "Auto (ATR Based)"], group = G_MAIN)
string sig_candle   = input.string("Running Candle", "Signal Based On", options = ["Running Candle", "Closed Candle"], tooltip = "Running = current close; Closed = previous bar close", group = G_MAIN)

bool use_rsi = input.bool(false, "Enable RSI Filter", group = G_FILTERS)
int  rsi_len = input.int(14, "RSI Length", inline = "rsi", group = G_FILTERS)
int  rsi_val = input.int(50, "RSI Baseline", inline = "rsi", group = G_FILTERS)
bool use_macd = input.bool(false, "Enable MACD Filter", group = G_FILTERS)

bool   use_tsl   = input.bool(true, "Enable Trailing Stop Loss", group = G_TSL)
string tsl_mode  = input.string("ATR-based", "TSL Method", options = ["ATR-based", "Percentage", "Fixed points"], group = G_TSL)
float  tsl_atr_m = input.float(2.0, "TSL ATR Multiplier", step = 0.1, group = G_TSL)
float  tsl_pct   = input.float(1.5, "TSL Percentage %", step = 0.1, group = G_TSL)
float  tsl_pts   = input.float(50.0, "TSL Fixed Points", step = 1.0, group = G_TSL)

bool   use_tgts = input.bool(true, "Enable Targets", group = G_TGTS)
string tgt_mode = input.string("ATR multiples", "Target Method", options = ["ATR multiples", "R:R ratio", "Fixed points"], group = G_TGTS)
float  t1_val   = input.float(2.0, "Target 1 Value", step = 0.5, inline = "t1", group = G_TGTS)
float  t2_val   = input.float(4.0, "Target 2 Value", step = 0.5, inline = "t2", group = G_TGTS)
float  t3_val   = input.float(6.0, "Target 3 Value", step = 0.5, inline = "t3", group = G_TGTS)

bool   show_stats = input.bool(true, "Show Statistics Panel", group = G_VIS)
string stat_pos   = input.string("Bottom Right", "Table Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = G_VIS)
string stat_size  = input.string("Small", "Text Size", options = ["Tiny", "Small", "Normal", "Large"], group = G_VIS)
color  col_up     = input.color(#00E676, "Bullish Color", inline = "col", group = G_VIS)
color  col_dn     = input.color(#FF5252, "Bearish Color", inline = "col", group = G_VIS)
color  col_tsl    = input.color(#FF9800, "TSL Color", inline = "col", group = G_VIS)

// ==============================================================================
// HELPERS (pure / drawing only — no global var mutation)
// ==============================================================================
f_table_pos(p) =>
    switch p
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

f_table_size(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        => size.large

f_calc_targets(entry, dir, atr_v, sl_dist) =>
    d1 = tgt_mode == "ATR multiples" ? atr_v * t1_val : tgt_mode == "R:R ratio" ? sl_dist * t1_val : t1_val
    d2 = tgt_mode == "ATR multiples" ? atr_v * t2_val : tgt_mode == "R:R ratio" ? sl_dist * t2_val : t2_val
    d3 = tgt_mode == "ATR multiples" ? atr_v * t3_val : tgt_mode == "R:R ratio" ? sl_dist * t3_val : t3_val
    t1 = dir == 1 ? entry + d1 : entry - d1
    t2 = dir == 1 ? entry + d2 : entry - d2
    t3 = dir == 1 ? entry + d3 : entry - d3
    [t1, t2, t3]

f_calc_tsl(dir, extreme, atr_v) =>
    tsl_mode == "ATR-based" ? (dir == 1 ? extreme - atr_v * tsl_atr_m : extreme + atr_v * tsl_atr_m) : tsl_mode == "Percentage" ? (dir == 1 ? extreme * (1.0 - tsl_pct / 100.0) : extreme * (1.0 + tsl_pct / 100.0)) : (dir == 1 ? extreme - tsl_pts : extreme + tsl_pts)

f_draw_targets(t1, t2, t3, dir) =>
    c = dir == 1 ? col_up : col_dn
    l1 = line.new(bar_index, t1, bar_index + 1, t1, color = color.new(c, 30), style = line.style_dashed)
    l2 = line.new(bar_index, t2, bar_index + 1, t2, color = color.new(c, 30), style = line.style_dashed)
    l3 = line.new(bar_index, t3, bar_index + 1, t3, color = color.new(c, 30), style = line.style_dashed)
    [l1, l2, l3]

// ==============================================================================
// ADAPTATION METHODS
// ==============================================================================
float atr      = ta.atr(base_atr_len)
float atr_sma  = ta.sma(atr, 50)
float atr_sd   = ta.stdev(atr, 50)
float atr_safe = math.max(atr, syminfo.mintick)

// 1) Percentile — higher ATR rank → tighter band
float pct_rank = ta.percentrank(atr, 100)
float m1_mult  = base_mult * (1.5 - pct_rank / 100.0)

// 2) Volatility regime
float m2_mult = atr > atr_sma * 1.5 ? 1.5 : atr < atr_sma * 0.5 ? 4.0 : 2.5

// 3) Z-Score
float atr_z   = atr_sd == 0.0 ? 0.0 : (atr - atr_sma) / atr_sd
float m3_mult = math.max(1.0, base_mult - atr_z * 0.3)

// 4) Dynamic period — fixed ATR lengths only (Pine requires const length)
int   m4_period = int(math.floor(math.max(7.0, math.min(20.0, base_atr_len * (atr_sma / atr_safe)))))
float atr7      = ta.atr(7)
float atr14     = ta.atr(14)
float atr20     = ta.atr(20)
float m4_atr    = m4_period <= 10 ? atr7 : m4_period <= 16 ? atr14 : atr20
float m4_mult   = base_mult

// 5) Rate of Change
float atr_roc = ta.roc(atr, 20)
float m5_mult = base_mult * (1.0 - atr_roc / 100.0 * 0.1)

// 6) Multi-Timeframe
float htf_atr = request.security(syminfo.tickerid, "D", ta.atr(base_atr_len), lookahead = barmerge.lookahead_off)
float m6_mult = base_mult * (htf_atr / atr_safe)

// 7) Hybrid
float hybrid_mult = ta.ema((m1_mult + m2_mult + m3_mult + base_mult + m5_mult) / 5.0, 5)

// 8) Auto
float auto_mult = atr > atr_sma ? m2_mult : m1_mult

float active_mult = switch method_type
    "Percentile"        => m1_mult
    "Volatility Regime" => m2_mult
    "Z-Score"           => m3_mult
    "Dynamic Period"    => m4_mult
    "Rate of Change"    => m5_mult
    "Multi-Timeframe"   => m6_mult
    "Hybrid"            => hybrid_mult
    "Auto (ATR Based)"  => auto_mult
    => base_mult

float active_atr = method_type == "Dynamic Period" ? m4_atr : atr

// ==============================================================================
// SUPERTREND
// ==============================================================================
float src = sig_candle == "Running Candle" ? close : close[1]

var float up    = na
var float dn    = na
var float st    = na
var int   trend = 1

up := hl2 - active_mult * active_atr
dn := hl2 + active_mult * active_atr

up := nz(src[1]) > nz(up[1]) ? math.max(up, nz(up[1])) : up
dn := nz(src[1]) < nz(dn[1]) ? math.min(dn, nz(dn[1])) : dn

trend := src > nz(dn[1]) ? 1 : src < nz(up[1]) ? -1 : nz(trend[1], 1)
st    := trend == 1 ? up : dn

// ==============================================================================
// SIGNAL FILTERS
// ==============================================================================
float rsi_now = ta.rsi(close, rsi_len)
bool  rsi_ok_long  = not use_rsi or rsi_now > rsi_val
bool  rsi_ok_short = not use_rsi or rsi_now < rsi_val

[macd_line, macd_sig, _] = ta.macd(close, 12, 26, 9)
bool macd_ok_long  = not use_macd or macd_line > macd_sig
bool macd_ok_short = not use_macd or macd_line < macd_sig

bool buy_signal  = ta.crossover(src, nz(dn[1])) and rsi_ok_long and macd_ok_long
bool sell_signal = ta.crossunder(src, nz(up[1])) and rsi_ok_short and macd_ok_short

// ==============================================================================
// TRADE STATE
// ==============================================================================
var int   pos_dir     = 0
var float entry_price = na
var float initial_sl  = na
var float run_high    = na
var float run_low     = na

var float tsl_level = na
var bool  tsl_hit   = false

var float t1_level = na
var float t2_level = na
var float t3_level = na
var bool  t1_hit   = false
var bool  t2_hit   = false
var bool  t3_hit   = false

var line t1_line = na
var line t2_line = na
var line t3_line = na

// Snapshot before mutations (for P&L)
int   prev_pos   = pos_dir
float prev_entry = entry_price

if buy_signal or sell_signal
    dir = buy_signal ? 1 : -1
    line.delete(t1_line)
    line.delete(t2_line)
    line.delete(t3_line)
    pos_dir     := dir
    entry_price := close
    initial_sl  := st
    run_high    := dir == 1 ? high : na
    run_low     := dir == -1 ? low : na
    tsl_level   := na
    tsl_hit     := false
    t1_hit := false
    t2_hit := false
    t3_hit := false

    sl_dist = math.abs(entry_price - initial_sl)
    [nt1, nt2, nt3] = f_calc_targets(entry_price, dir, active_atr, sl_dist)
    t1_level := nt1
    t2_level := nt2
    t3_level := nt3

    if use_tgts
        [l1, l2, l3] = f_draw_targets(t1_level, t2_level, t3_level, dir)
        t1_line := l1
        t2_line := l2
        t3_line := l3
    else
        t1_line := na
        t2_line := na
        t3_line := na

// Extend target lines & update extremes
if pos_dir == 1
    run_high := math.max(nz(run_high, high), high)
    if use_tgts
        if not t1_hit
            line.set_x2(t1_line, bar_index)
        if not t2_hit
            line.set_x2(t2_line, bar_index)
        if not t3_hit
            line.set_x2(t3_line, bar_index)
else if pos_dir == -1
    run_low := math.min(nz(run_low, low), low)
    if use_tgts
        if not t1_hit
            line.set_x2(t1_line, bar_index)
        if not t2_hit
            line.set_x2(t2_line, bar_index)
        if not t3_hit
            line.set_x2(t3_line, bar_index)

// Trailing stop
bool  tsl_exit       = false
float tsl_exit_price = na

if use_tsl and pos_dir != 0 and not tsl_hit
    extreme = pos_dir == 1 ? run_high : run_low
    new_tsl = f_calc_tsl(pos_dir, extreme, active_atr)

    if pos_dir == 1
        tsl_level := na(tsl_level) ? new_tsl : math.max(tsl_level, new_tsl)
        if close < tsl_level
            tsl_hit := true
            tsl_exit := true
            tsl_exit_price := tsl_level
            label.new(bar_index, low, "✕ TSL", color = color.new(col_tsl, 80), style = label.style_label_up, textcolor = col_tsl, size = size.small)
            line.delete(t1_line)
            line.delete(t2_line)
            line.delete(t3_line)
            t1_line := na
            t2_line := na
            t3_line := na
            tsl_level := na
            pos_dir := 0
    else
        tsl_level := na(tsl_level) ? new_tsl : math.min(tsl_level, new_tsl)
        if close > tsl_level
            tsl_hit := true
            tsl_exit := true
            tsl_exit_price := tsl_level
            label.new(bar_index, high, "✕ TSL", color = color.new(col_tsl, 80), style = label.style_label_down, textcolor = col_tsl, size = size.small)
            line.delete(t1_line)
            line.delete(t2_line)
            line.delete(t3_line)
            t1_line := na
            t2_line := na
            t3_line := na
            tsl_level := na
            pos_dir := 0

// Target hits
if use_tgts and pos_dir == 1
    if not t1_hit and high >= t1_level
        t1_hit := true
        label.new(bar_index, t1_level, "T1✓", style = label.style_none, textcolor = col_up, size = size.small)
        line.set_color(t1_line, color.new(col_up, 80))
    if not t2_hit and high >= t2_level
        t2_hit := true
        label.new(bar_index, t2_level, "T2✓", style = label.style_none, textcolor = col_up, size = size.small)
        line.set_color(t2_line, color.new(col_up, 80))
    if not t3_hit and high >= t3_level
        t3_hit := true
        label.new(bar_index, t3_level, "T3✓", style = label.style_none, textcolor = col_up, size = size.small)
        line.set_color(t3_line, color.new(col_up, 80))
else if use_tgts and pos_dir == -1
    if not t1_hit and low <= t1_level
        t1_hit := true
        label.new(bar_index, t1_level, "T1✓", style = label.style_none, textcolor = col_dn, size = size.small)
        line.set_color(t1_line, color.new(col_dn, 80))
    if not t2_hit and low <= t2_level
        t2_hit := true
        label.new(bar_index, t2_level, "T2✓", style = label.style_none, textcolor = col_dn, size = size.small)
        line.set_color(t2_line, color.new(col_dn, 80))
    if not t3_hit and low <= t3_level
        t3_hit := true
        label.new(bar_index, t3_level, "T3✓", style = label.style_none, textcolor = col_dn, size = size.small)
        line.set_color(t3_line, color.new(col_dn, 80))

// ==============================================================================
// PLOTS
// ==============================================================================
plot(st, "SuperTrend", color = trend == 1 ? col_up : col_dn, linewidth = 2)
plot(use_tsl and not tsl_hit and pos_dir != 0 ? tsl_level : na, "Trailing SL", color = col_tsl, linewidth = 1, style = plot.style_linebr)

plotshape(buy_signal, "Buy", shape.triangleup, location.belowbar, col_up, size = size.small)
plotshape(sell_signal, "Sell", shape.triangledown, location.abovebar, col_dn, size = size.small)

// ==============================================================================
// STATISTICS PANEL
// ==============================================================================
var float total_pnl    = 0.0
var int   total_trades = 0
var int   win_trades   = 0

// Reverse-signal closes
bool closed_long  = sell_signal and prev_pos == 1 and not na(prev_entry)
bool closed_short = buy_signal and prev_pos == -1 and not na(prev_entry)

if closed_long
    pts = close - prev_entry
    total_pnl    += pts
    total_trades += 1
    if pts > 0
        win_trades += 1
else if closed_short
    pts = prev_entry - close
    total_pnl    += pts
    total_trades += 1
    if pts > 0
        win_trades += 1

// TSL closes (skip if reverse already counted this bar)
if tsl_exit and not closed_long and not closed_short and not na(prev_entry) and prev_pos != 0
    pts = prev_pos == 1 ? tsl_exit_price - prev_entry : prev_entry - tsl_exit_price
    total_pnl    += pts
    total_trades += 1
    if pts > 0
        win_trades += 1

if show_stats and barstate.islast
    pos = f_table_pos(stat_pos)
    sz  = f_table_size(stat_size)

    var table tb = table.new(pos, 2, 6, bgcolor = color.new(color.black, 80), border_width = 1, border_color = color.gray)
    table.set_position(tb, pos)

    table.cell(tb, 0, 0, "Adaptive Method", text_color = color.white, text_size = sz, bgcolor = color.new(color.blue, 70))
    table.cell(tb, 1, 0, method_type, text_color = color.white, text_size = sz)

    table.cell(tb, 0, 1, "Current Trend", text_color = color.white, text_size = sz)
    table.cell(tb, 1, 1, trend == 1 ? "BULLISH" : "BEARISH", text_color = trend == 1 ? col_up : col_dn, text_size = sz)

    table.cell(tb, 0, 2, "Current ATR", text_color = color.white, text_size = sz)
    table.cell(tb, 1, 2, str.tostring(active_atr, "#.##"), text_color = color.white, text_size = sz)

    table.cell(tb, 0, 3, "Total Trades", text_color = color.white, text_size = sz)
    table.cell(tb, 1, 3, str.tostring(total_trades), text_color = color.white, text_size = sz)

    win_rate = total_trades > 0 ? win_trades / total_trades * 100.0 : 0.0
    table.cell(tb, 0, 4, "Win Rate", text_color = color.white, text_size = sz)
    table.cell(tb, 1, 4, str.tostring(win_rate, "#.##") + "%", text_color = color.white, text_size = sz)

    table.cell(tb, 0, 5, "Total P&L (Pts)", text_color = color.white, text_size = sz)
    table.cell(tb, 1, 5, str.tostring(total_pnl, "#.##"), text_color = total_pnl >= 0 ? col_up : col_dn, text_size = sz)

# Firstock (optional / legacy)
FIRSTOCK_USER_ID=
FIRSTOCK_PASSWORD=
FIRSTOCK_API_KEY=
FIRSTOCK_VENDOR_CODE=
FIRSTOCK_TOTP_SECRET=

# Static IP proxy (staticip.in) — Zerodha / broker egress whitelist
STATICIP_HOST=dc-mum-601.staticip.in
STATICIP_PORT=443
STATICIP_SCHEME=http
STATICIP_USER=
STATICIP_PASSWORD=

# Zerodha Kite Connect (required for Kite backtest / live)
# https://www.kite.trade/docs/connect/v3/
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:8001/auth/callback
# Where to send the browser after Kite OAuth succeeds (dev UI)
DESK_UI_URL=http://127.0.0.1:8080
# MARKET orders need protection via API: -1 = auto (recommended), or 0.1–100 for custom %
KITE_MARKET_PROTECTION=-1
ZERODHA_CLIENT_ID=
# Route Kite egress through the staticip.in proxy: 0 = direct (recommended when whitelisted IPv6 is local), 1 = use STATICIP_* above
KITE_USE_STATICIP_PROXY=0
# When local IPv6 bind fails on Windows, retry orders via direct egress (auto | 1 | 0).
KITE_ORDER_DIRECT_FALLBACK=auto
# IPv6 whitelisted on developers.kite.trade. When present on this PC, 3ST binds orders to it (preferred over staticip proxy).
KITE_ALLOWED_EGRESS_IP=

# Live Desk LTP cache (Aio-Trader KiteFeed WebSocket + Kite REST fallback)
# WebSocket feed on/off (falls back to REST if aio-trader is not installed)
LTP_CACHE_WS=1
# Cached tick is considered fresh for this many seconds before a REST refetch
LTP_CACHE_TTL_SEC=15
# WebSocket subscription refresh interval (seconds)
LTP_CACHE_REFRESH_SEC=30
# Allow REST quote/LTP fallback when the WS cache misses or is stale
LTP_CACHE_REST_FALLBACK=1

# Equity Report desk (/equity-report) — LLM research reports only.
# Never touches broker/execution/risk. Leave the provider's key blank to disable the desk.
EQUITY_REPORT_PROVIDER=anthropic
# --- provider: anthropic (full web_search + web_fetch) ---
ANTHROPIC_API_KEY=
EQUITY_REPORT_MODEL=claude-opus-5
# low | medium | high | xhigh | max — controls reasoning depth and token spend
EQUITY_REPORT_EFFORT=high
# Refuse to queue a new report once today's spend crosses this (USD). 0 = no cap.
EQUITY_REPORT_DAILY_USD_CAP=10
# 1 = return canned placeholder reports without calling the API (UI work, zero spend)
EQUITY_REPORT_STUB=0

# --- provider: gemini (url_context only — no search, see below) ---
GEMINI_API_KEY=
# 3.5-flash-lite follows the report template best; 3.6-flash is richer but long
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high
EQUITY_REPORT_GEMINI_THINKING=medium
# Google Search grounding has its own quota that free-tier keys do NOT include
# (it 429s while url_context succeeds). Only turn on with a plan that grants it.
EQUITY_REPORT_GEMINI_SEARCH=0
